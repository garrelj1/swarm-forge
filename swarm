#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAIN_BRANCH="${SWARMFORGE_SCRIPTS_BRANCH:-main}"
ARCHIVE_URL="${SWARMFORGE_SCRIPTS_URL:-https://github.com/garrelj1/swarm-forge/archive/refs/heads/${MAIN_BRANCH}.tar.gz}"
TMP_DIR=""

cleanup() {
  if [[ -n "$TMP_DIR" ]]; then
    rm -rf "$TMP_DIR"
  fi
}
trap cleanup EXIT

# The PM prompt is pack-independent and lives only on main, but six-pack
# configures a `window PM`, and the launcher refuses to start when a configured
# role has no prompt. Fetch it here so a fresh checkout runs without first
# having to be updated by update-swarmforge.sh.
if [[ ! -d "$SCRIPT_DIR/swarmforge/scripts" || ! -d "$SCRIPT_DIR/swarmforge/scripts/shared-articles" || ! -d "$SCRIPT_DIR/swarmforge-electron" || ! -f "$SCRIPT_DIR/swarmforge/roles/PM.prompt" ]]; then
  TMP_DIR="$(mktemp -d)"
  mkdir -p "$SCRIPT_DIR/swarmforge"
  curl -L "$ARCHIVE_URL" | tar -xz --strip-components=1 -C "$TMP_DIR"
  if [[ ! -d "$SCRIPT_DIR/swarmforge/scripts" ]]; then
    cp -R "$TMP_DIR/swarmforge/scripts" "$SCRIPT_DIR/swarmforge/scripts"
  fi
  if [[ -d "$TMP_DIR/swarmforge/constitution/articles" ]]; then
    mkdir -p "$SCRIPT_DIR/swarmforge/scripts/shared-articles"
    cp -R "$TMP_DIR/swarmforge/constitution/articles/." "$SCRIPT_DIR/swarmforge/scripts/shared-articles/"
  fi
  if [[ ! -d "$SCRIPT_DIR/swarmforge-electron" && -d "$TMP_DIR/swarmforge-electron" ]]; then
    cp -R "$TMP_DIR/swarmforge-electron" "$SCRIPT_DIR/swarmforge-electron"
  fi
  if [[ ! -f "$SCRIPT_DIR/swarmforge/roles/PM.prompt" && -f "$TMP_DIR/swarmforge/roles/PM.prompt" ]]; then
    mkdir -p "$SCRIPT_DIR/swarmforge/roles"
    cp "$TMP_DIR/swarmforge/roles/PM.prompt" "$SCRIPT_DIR/swarmforge/roles/PM.prompt"
  fi
fi

exec "$SCRIPT_DIR/swarmforge/scripts/swarmforge.sh" "$@"
